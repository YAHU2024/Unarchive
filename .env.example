# LLM Configuration
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Feishu Configuration
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret

# ima Configuration (optional, for syncing to Tencent ima)
IMA_CLIENT_ID=your_ima_client_id
IMA_API_KEY=your_ima_api_key
# IMA_KNOWLEDGE_BASE_ID=your_knowledge_base_id  # optional: add note to this KB on sync
# IMA_KNOWLEDGE_BASE_FOLDER_ID=your_folder_id  # optional: KB target folder id (root if empty)
# IMA_KNOWLEDGE_BASE_FOLDER_NAME=your_folder_name  # optional: resolve folder by name if id empty
# NOTE: ima OpenAPI cannot create knowledge bases. Create one in the ima client
# (desktop/web) first, then run `python cli.py ima-kbs` to discover its ID.

# Whisper Configuration
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_PROFILE=fast
WHISPER_LANGUAGE=auto
# AUDIO_CACHE_MAX_AGE_DAYS=7
# AUDIO_CACHE_MAX_BYTES=2147483648

# Data directories (optional, defaults shown)
# Set DATA_DIR to relocate all state/cache/logs at once;
# individual dirs override the defaults derived from DATA_DIR.
DATA_DIR=./data
TRANSCRIPTS_DIR=./data/transcripts
AUDIO_CACHE_DIR=./data/audio_cache
KNOWLEDGE_BASE_DIR=./data/knowledge_base
COOKIES_DIR=./data/cookies
LOGS_DIR=./data/logs
CHROME_PROFILE_DIR=./data/chrome_profile
VIDEO_DOWNLOAD_DIR=./data/videos
